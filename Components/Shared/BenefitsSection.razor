@code {
    private readonly BenefitItem[] _items =
    [
        new("Cash Assistance", "Gifts, DPA programs, seller credits, lender credits, and inspection leverage."),
        new("Optimizer", "Use structured options like balance transfer analysis, integrators, and fee planning."),
        new("Scenario Planning", "Compare multiple properties and financing structures side by side."),
        new("Guided Funnel", "Move from uncertainty to action with a practical decision path.")
    ];

    private sealed record BenefitItem(string Title, string Description);
}

<section id="benefits" class="section-block section-dark">
    <div class="landing-container benefits-grid">
        <div>
            <div class="section-kicker dark-kicker">Why Zer0sts</div>
            <h2>One system to organize a smarter home purchase.</h2>
            <p class="section-copy-dark">
                From prequalification to structuring assistance, credits, and negotiation points,
                Zer0sts centralizes the moving parts into a cleaner buyer experience.
            </p>
        </div>

        <div class="benefit-cards-grid">
            @foreach (var item in _items)
            {
                <article class="benefit-card">
                    <h3>@item.Title</h3>
                    <p>@item.Description</p>
                </article>
            }
        </div>
    </div>
</section>
