<section id="contact" class="section-block contact-section">
    <div class="landing-container">
        <div class="contact-shell">
            <div class="contact-copy">
                <div class="section-kicker">Contact</div>
                <h2>Talk to Zer0sts</h2>
                <p>
                    Whether you are ready to buy now or need a better plan first,
                    our team can help you understand your next step.
                </p>

                <div class="contact-points">
                    <div class="contact-point">
                        <span class="contact-label">Email</span>
                        <span class="contact-value">hello@zer0sts.com</span>
                    </div>

                    <div class="contact-point">
                        <span class="contact-label">Phone</span>
                        <span class="contact-value">+1 (303) 555-0189</span>
                    </div>

                    <div class="contact-point">
                        <span class="contact-label">Office</span>
                        <span class="contact-value">1700 Lincoln St, Denver, CO 80203</span>
                    </div>

                    <div class="contact-point">
                        <span class="contact-label">Hours</span>
                        <span class="contact-value">Mon - Fri | 9:00 AM - 6:00 PM</span>
                    </div>
                </div>
            </div>

            <div class="contact-card">
                <h3>Request guidance</h3>
                <p>Tell us a bit about your situation and we will follow up with next steps.</p>

                <form class="contact-form">
                    <input type="text" placeholder="Full name" />
                    <input type="email" placeholder="Email address" />
                    <input type="text" placeholder="Phone number" />
                    <textarea rows="5" placeholder="Tell us where you are in your homebuying process"></textarea>
                    <button type="button" class="contact-submit">Send request</button>
                </form>
            </div>
        </div>
    </div>
</section>